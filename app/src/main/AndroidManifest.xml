<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline banner / sync-state detection; the app is fully usable offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Supabase sync/auth and Google Drive/Calendar REST (Wave 1). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (Android 11+): resolve installed UPI apps for the About
         screen's Donate link so a missing handler degrades to a localized notice. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:name=".SamarohApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/common_app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Samaroh">

        <!-- singleTask: warm App-Link/notification launches reuse the single shell
             instance via onNewIntent instead of stacking duplicates (ADR-033). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Samaroh.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android App Links (ADR-033): open web URLs in the app. autoVerify
                 requires https://samaroh-web.vercel.app/.well-known/assetlinks.json to
                 list this package's signing cert; until the web deploy lands, verify
                 manually per docs/decisions.md ADR-033. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="samaroh-web.vercel.app"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- AndroidX per-app locales (§5): persists the chosen locale across restarts
             on every supported API level (backport of the Android 13+ system setting). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
