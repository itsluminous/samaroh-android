<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Offline banner / sync-state detection; the app is fully usable offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Supabase sync/auth and Google Drive/Calendar REST (Wave 1). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".SamarohApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/common_app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Samaroh">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AndroidX per-app locales (§5): persists the chosen locale across restarts
             on every supported API level (backport of the Android 13+ system setting). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
