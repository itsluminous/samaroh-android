<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- All permissions here are OPTIONAL at runtime (§6): reminders degrade gracefully
         when notifications are denied; the in-app Pending-confirmations card is the
         reliable path. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application>

        <!-- Alarm-style upcoming-event reminder (§4.1 full-screen popup style). -->
        <activity
            android:name=".reminders.FullScreenReminderActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SamarohBooking.FullScreenReminder"
            android:turnScreenOn="true" />

        <!-- Handles the payment-reminder notification actions (Yes-full / Not-yet). -->
        <receiver
            android:name=".reminders.PaymentReminderActionReceiver"
            android:exported="false" />

        <!-- Fires the exact-time full-screen upcoming-event reminder. -->
        <receiver
            android:name=".reminders.UpcomingReminderAlarmReceiver"
            android:exported="false" />

        <!-- Shares invoice PDFs generated by core:invoice with other apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.booking.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/booking_file_paths" />
        </provider>
    </application>

</manifest>
